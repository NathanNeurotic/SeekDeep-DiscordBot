{
  "__doc__": [
    "DUP-1 single source of truth for the runtime file set that must stay in sync",
    "across self-update/signing/bundling/extraction consumers. The preflight",
    "`release-files` guard (scripts/check-release-files.mjs) parses each consumer",
    "and fails if it drifts from this file. When you add/remove shipped runtime",
    "code, edit THIS file first; preflight names the consumer lists to update.",
    "",
    "Consumers:",
    "  gui_endpoints.py            self-updater `single_files` == core_files",
    "                              fetched top-level subtrees == subdirs",
    "  release_signing.py          MANIFEST_SINGLE_FILES == core_files",
    "                              MANIFEST_SUBDIRS == subdirs",
    "  src-tauri/tauri.conf.json   bundle.resources == core_files + bundle_extra",
    "                              + bundle_subdirs globs",
    "  src-tauri/src/sidecar.rs    extraction `let files = [...]` == core_files",
    "                              + bundle_extra; gui/ + lib/ recurse separately",
    "",
    "scripts/ is self-updated/signed as a subtree, but the installer only needs",
    "the specific runtime scripts in bundle_extra. gui/ and lib/ are bundled",
    "recursively because the installed GUI and Discord bot execute them directly."
  ],
  "core_files": [
    "local_ai_server.py",
    "gui_endpoints.py",
    "warmup_local_cache.py",
    "release_signing.py",
    "package.json",
    "package-lock.json",
    "index.js",
    "requirements-local.txt",
    "requirements-ml.txt"
  ],
  "bundle_extra": [
    ".env.default",
    ".env.example",
    "scripts/doctor.mjs",
    "scripts/preflight.mjs",
    "scripts/smoke_gui_endpoints.py"
  ],
  "subdirs": [
    "gui",
    "scripts",
    "lib"
  ],
  "bundle_subdirs": [
    "gui",
    "lib"
  ]
}
